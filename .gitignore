__pycache__/
*.pyc
*.pyo
*.swp
.DS_Store
.Rhistory
build/
*.s4ext

# pyproject / setuptools build artifacts (rosa-agent install).
*.egg-info/
dist/
*.egg

# Local-only session notes — handoff + resume prompts, Claude memory,
# and any per-session scratch docs. Keep these out of the public repo.
docs/CONTACT_PITCH_V1_HANDOFF.md
docs/NEXT_SESSION_PROMPT.md
docs/*_HANDOFF.md
docs/*_SESSION_*.md
CLAUDE.md
.claude/

# Test fixture binaries: large NIfTI volumes (T22 CT etc.) live alongside
# tracked tsv/txt fixtures. Keep them on local disk only.
tests/data/**/*.nii
tests/data/**/*.nii.gz

# Research notebooks: local-path-bound (point at private data dirs);
# kept out of the repo. Memory references them as resume anchors;
# they live on local disk only.
notebooks/

# Local-only probe / diagnostic scratch scripts. The committed tools/
# utilities don't use the leading-underscore prefix; the _*.py files are
# one-off A/B and diagnostic harnesses that accumulate during sessions.
tools/_*.py
